{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "apps/**/src/**/*.ts",
      "apps/**/src/**/*.tsx",
      "apps/training-api/drizzle.config.ts",
      "apps/training-web/pages/**/*.ts",
      "apps/training-web/pages/**/*.tsx",
      "packages/**/src/**/*.ts"
    ]
  }
}
